    {
      "parameters": {
        "jsCode": "const availableTimes = ($json.times ?? [])\n    .filter((time) => time.available)\n    .map((time) => time.label);\n\n  const [year, month, day] = String($json.date).split(\"-\");\n  const formattedDate = `${day}/${month}/${year}`;\n  const doctorName = $json.doctor?.name ?? \"o médico selecionado\";\n\n  let reply;\n\n  if (availableTimes.length === 0) {\n    reply = `Não encontrei horários disponíveis para ${doctorName} em ${formattedDate}. Deseja consultar outra data?`;\n  } else {\n    reply =\n      `Para ${formattedDate}, ${doctorName} possui estes horários disponíveis:\\n\\n` +\n      availableTimes.join(\", \") +\n      \"\\n\\nQual horário você gostaria de escolher?\";\n  }\n\n  return [{\n    json: {\n      reply\n    }\n  }];"
      },
