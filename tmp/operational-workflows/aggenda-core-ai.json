    {
      "parameters": {
        "jsCode": "const items = $json.appointments ?? [];\nconst reply = items.length\n  ? 'Seus próximos agendamentos são:\\n\\n' + items.map((item, index) => `${index + 1}. ${item.serviceName} — ${item.startsAtLocal} — ${item.professionalName || 'profissional a definir'} — código ${item.id}`).join('\\n') + '\\n\\nVocê pode pedir para reagendar ou cancelar informando o número da opção.'\n  : 'Não encontrei próximos agendamentos vinculados a este telefone.';\nreturn [{ json: { reply, appointments: items } }];"
      },
