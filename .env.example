DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-mails transacionais (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Aggenda <contato@aggenda.app.br>
FINANCIAL_INTEGRATION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: se vazio, os tokens do Google são criptografados com BETTER_AUTH_SECRET.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Usadas somente ao executar `npm run admin:create`
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_ORGANIZATION=Aggenda Administração

# Assinaturas Asaas
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_PLAN_VALUE=5
NEXT_PUBLIC_PLAN_PRICE=R$ 5
ASAAS_PLAN_MONTHLY_VALUE=5
ASAAS_PLAN_QUARTERLY_VALUE=267
ASAAS_PLAN_SEMIANNUAL_VALUE=474
ASAAS_PLAN_ANNUAL_VALUE=828

# Stripe legado (manter somente durante a migração)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL=

# Integração n8n
N8N_API_KEY=
N8N_CLINIC_ID=
NEXT_PUBLIC_N8N_WHATSAPP_URL=
N8N_BASE_URL=
N8N_WORKFLOW_ID=

# Camada própria de IA (API compatível com Chat Completions)
# Use aqui o mesmo endpoint, chave e modelo já adotados no projeto.
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
# Segredo compartilhado entre o worker e as rotas internas do Aggenda.
AGGENDA_INTERNAL_API_URL=https://www.aggenda.app.br
AGGENDA_INTERNAL_API_KEY=
# URL pública do serviço de Outbox no Coolify. A aplicação chama POST /drain.
OUTBOX_WORKER_TRIGGER_URL=https://worker.aggenda.app.br
# Opcional: se vazio, o worker reutiliza AGGENDA_INTERNAL_API_KEY.
OUTBOX_TRIGGER_SECRET=
# O n8n recebe somente eventos de automações comerciais publicadas.
N8N_COMMERCIAL_WEBHOOK_URL=

# WhatsApp Cloud API e processamento assíncrono
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_WHATSAPP_CONFIGURATION_ID=
WHATSAPP_TOKEN_ENCRYPTION_KEY=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_GRAPH_VERSION=v23.0
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_DISPLAY_PHONE_NUMBER=
META_TEMPLATE_APPOINTMENT_CONFIRMATION=
META_TEMPLATE_APPOINTMENT_RESCHEDULE=
META_TEMPLATE_APPOINTMENT_CANCELLATION=
META_TEMPLATE_APPOINTMENT_REMINDER=
META_TEMPLATE_PAYMENT_CHARGE=
META_TEMPLATE_PAYMENT_DUNNING=
META_TEMPLATE_PATIENT_RECOVERY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
WHATSAPP_ORGANIZATION_ID=
CRON_SECRET=
OUTBOX_WORKER_ID=aggenda-worker-1
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_BATCHES_PER_RUN=20
# Varredura de lembretes e recuperação; mínimo aceito pelo worker: 10 minutos.
WHATSAPP_REMINDER_INTERVAL_MS=900000
PORT=3000

# Administração global da plataforma (usado apenas pelo script platform:grant)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_ROLE=super_admin
