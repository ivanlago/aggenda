      "name": "Preparar confirmação"
    },
    {
      "parameters": {
        "url": "https://www.aggenda.app.br/api/n8n/services",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
