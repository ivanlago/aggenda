        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.action === 'cancel_appointment'\n  ? { status: 'cancelled', cancellationReason: $json.cancellationReason }\n  : { startsAt: $json.date + 'T' + $json.time + ':00-03:00', status: 'scheduled' }) }}",
