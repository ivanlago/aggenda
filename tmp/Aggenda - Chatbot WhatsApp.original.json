    {
      "parameters": {
        "jsCode": "const raw = String($json.output ?? \"\").trim();\n\n  const cleaned = raw\n    .replace(/^```json\\s*/i, \"\")\n    .replace(/^```\\s*/i, \"\")\n    .replace(/\\s*```$/i, \"\")\n    .trim();\n\n  try {\n    const decision = JSON.parse(cleaned);\n\n    return [{\n      json: {\n        ...decision,\n        rawOutput: raw\n      }\n    }];\n  } catch (error) {\n    return [{\n      json: {\n        action: \"reply\",\n        reply: raw || \"Desculpe, não consegui interpretar sua solicitação. Poderia repetir?\",\n        doctorId: null,\n        doctorName: null,\n        date: null,\n        time: null,\n        patientName: null,\n        patientEmail: null,\n        patientSex: null,\n        rawOutput: raw,\n        parseError: true\n      }\n    }];\n  }"
      },
