        "jsonBody": "={\n  \"clientId\": \"{{ $json.client.id }}\",\n  \"serviceId\": \"{{ $('Atendimento Core determinístico').item.json.serviceId }}\",\n  \"professionalId\": \"{{ $('Atendimento Core determinístico').item.json.professionalId }}\",\n  \"startsAt\": \"{{ $('Atendimento Core determinístico').item.json.date + 'T' + $('Atendimento Core determinístico').item.json.time + ':00-03:00' }}\",\n  \"notes\": \"Criado pelo atendimento no WhatsApp via Aggenda Chat\"\n}",
